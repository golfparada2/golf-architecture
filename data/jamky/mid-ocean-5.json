  "prvky": [
    {
      "nazev": {
        "cs": "Sázka po metrech, ne ano/ne",
        "en": "A bet by the metre, not yes or no"
      },
      "popis": {
        "cs": "Voda leží podél hrany fairwaye šikmo, ne napříč. Každá linie odpalu má proto jinou délku přeletu a jinou odměnu — hráč si sázku nastavuje sám, plynule, ne dvěma tlačítky.",
        "en": "The water lies diagonally along the edge of the fairway, not across it. Every line off the tee has a different carry and a different reward — the player sets the size of the bet himself, continuously, not with two buttons."
      }
    },
    {
      "nazev": {
        "cs": "Odměna není jen kratší rána",
        "en": "The reward is not just a shorter shot"
      },
      "popis": {
        "cs": "Fairway i green se naklánějí zprava doleva a náklon je nejstrmější daleko od vody. Kdo ukrojí víc, dostane rovnější postoj a lepší úhel; kdo hraje bezpečně doprava, čelí greenu, který ránu odmítá.",
        "en": "Both fairway and green tilt right to left, and the tilt is steepest furthest from the water. Cut off more and you get a flatter stance and a better angle; play safe to the right and you face a green that rejects the shot."
      }
    },
    {
      "nazev": {
        "cs": "Předloha, kterou moderní kopie ztratily",
        "en": "The template modern copies lost"
      },
      "popis": {
        "cs": "Macdonald v roce 1914 definoval Cape podle greenu, ne podle odpalu: green vybíhá do vody, která ho obklopuje ze tří stran. Pátá jamka Mid Oceanu splňuje obojí — původní definici i tu moderní o diagonálním odpalu.",
        "en": "In 1914 Macdonald defined the Cape by its green, not its tee shot: the green runs out into the water, surrounded on three sides. Mid Ocean's fifth satisfies both — the original definition and the modern one about the diagonal drive."
      }
    }
  ],
