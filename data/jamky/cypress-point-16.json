  "prvky": [
    {
      "nazev": {
        "cs": "Přímý carry přes oceánskou zátoku — nebo bezpečnější cesta vlevo",
        "en": "A direct carry over an ocean bay — or a safer route to the left"
      },
      "popis": {
        "cs": "Odvážná linie vede přímo přes ~200 yardů oceánu ke greenu. MacKenzie ale sám popisoval tři alternativní cesty — přímou, střední (carry ~100 yardů) a ještě kratší podél levého útesu, kde povinný carry nikdy nepřesáhne ~80 yardů. Tahle levá trasa (tzv. „chicken run“) není snadný layup — sráz doleva je stále nebezpečný — ale existuje jako záchranná varianta pro opatrnější hráče.",
        "en": "The bold line plays directly over roughly 200 yards of ocean to the green. But MacKenzie himself described three alternative routes — the direct line, a middle option (about a 100-yard carry), and a still shorter route along the left-hand cliffs where the compulsory carry never exceeds about 80 yards. That left-side route (the so-called \"chicken run\") is no easy layup — the drop to the left is still dangerous — but it exists as an escape valve for more cautious players."
      }
    },
    {
      "nazev": {
        "cs": "Green obklopený vodou a skálami",
        "en": "A green ringed by water and rock"
      },
      "popis": {
        "cs": "Green je chráněný mořem a skalnatými výběžky ze tří stran, navíc hlídaný bunkery.",
        "en": "The green is guarded by the sea and rocky outcrops on three sides, plus bunkers."
      }
    },
    {
      "nazev": {
        "cs": "Routing obětovaný jednomu úseku",
        "en": "A routing sacrificed to one stretch"
      },
      "popis": {
        "cs": "Kvůli tomuto úseku pobřeží bylo pokáceno 15 akrů lesa navíc, jen aby vynikl výhled na oceán a duny.",
        "en": "An extra 15 acres of forest were cleared for this stretch alone, purely to open up views of the ocean and dunes."
      }
    }
  ],
