  "prvky": [
    {
      "nazev": {
        "cs": "Green v přirozené prohlubni",
        "en": "A green in a natural hollow"
      },
      "popis": {
        "cs": "Amfiteátrovitě zapuštěný mezi dunami — architekti popisují, že tuhle jamku „okamžitě uviděli“, aniž by cokoli museli upravovat.",
        "en": "Set amphitheater-like among the dunes — the architects describe \"seeing\" this hole immediately, without needing to shape anything."
      }
    },
    {
      "nazev": {
        "cs": "Bunkry tvarované větrem, ne strojem",
        "en": "Bunkers shaped by wind, not machine"
      },
      "popis": {
        "cs": "Roztřepené okraje vznikly větrnou erozí — nejde o pravidelné, buldozerem vymodelované tvary.",
        "en": "Their jagged edges came from wind erosion — not the regular shapes a bulldozer would produce."
      }
    },
    {
      "nazev": {
        "cs": "Šest bunkrů, nejvíc u greenu",
        "en": "Six bunkers, most of them by the green"
      },
      "popis": {
        "cs": "Na jamce je celkem 6 bunkrů. Nejsou rozeseté jen v dojezdu prvního úderu — hlavní shluk lemuje malý, úzký a hluboký green a hlídá druhý/třetí úder těsně před jamkou.",
        "en": "The hole carries six bunkers in total. They aren't just scattered around the layup zone — the main cluster frames the small, narrow, deep green and threatens the second or third shot right in front of the putting surface."
      }
    },
    {
      "nazev": {
        "cs": "Minimální zemní práce",
        "en": "Minimal earthmoving"
      },
      "popis": {
        "cs": "Na celém osmnáctijamkovém hřišti se přesunulo jen zhruba 4000 m³ zeminy — naprosté minimum.",
        "en": "Across all eighteen holes, only about 4,000 cubic metres of earth were moved — an absolute minimum."
      }
    }
