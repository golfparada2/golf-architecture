  "prvky": [
    {
      "nazev": {
        "cs": "Rybník končí před greenem",
        "en": "The pond ends short of the green"
      },
      "popis": {
        "cs": "Voda lemuje celou pravou stranu, ale k greenu se nedostane — ten leží až za jejím horním koncem. Kdo doletí, je za vodou; kdo ne, je v ní.",
        "en": "Water lines the whole right side but never reaches the green, which sits beyond its far end. Carry it and you are past it; come up short and you are in it."
      }
    },
    {
      "nazev": {
        "cs": "Green 19 × 35 metrů",
        "en": "A green 19 by 35 metres"
      },
      "popis": {
        "cs": "Skoro dvakrát tak hluboký, jak je široký. Mezi předním okrajem a středem je 18 metrů — volba klubu tady rozhoduje víc než směr.",
        "en": "Almost twice as deep as it is wide. There are 18 metres between the front edge and the middle, so club selection matters more than direction."
      }
    },
    {
      "nazev": {
        "cs": "Úzký pruh trávy vlevo",
        "en": "A narrow strip of grass on the left"
      },
      "popis": {
        "cs": "Jediná bezpečná strana. Je tak úzká, že bezpečná hra pořád vyžaduje přesnost — a nechává delší chip do kopce.",
        "en": "The only safe side. It is narrow enough that the safe play still demands precision, and it leaves a longer chip up the slope."
      }
    }
  ],
  "naCoSeDivat": {
    "cs": "Sleduj, kde rybník končí: jeho horní okraj je pod greenem, ne vedle něj. Proto se tahle jamka nehraje na směr, ale na délku — a proto je green 35 metrů hluboký.",
    "en": "Watch where the pond ends: its far edge is below the green, not beside it. That is why this hole is about length rather than line — and why the green is 35 metres deep."
  },
  "lekce": {
    "cs": "Hazard, který končí těsně před greenem, mění otázku ze „kam\" na „jak daleko\". Hloubka greenu je pak odpověď architekta na to, jak velkou chybu ještě odpustí.",
    "en": "A hazard that stops just short of the green turns the question from \"where\" into \"how far\". The depth of the green is then the architect's answer to how big a miss he will forgive."
  },
